# Settings of deploy/docker/compose.yaml. init.sh copies this file to .env
# and fills in the secrets. Keep .env private (mode 0600): it holds the
# master key, which decrypts the CA keys and credentials in the database.

# Image names and version (as built by `make docker-build`).
BOMCENSUS_REPO=bomcensus
BOMCENSUS_VERSION=0.0.0-dev

# Host ports. Inside the containers the server always listens on 8080 (web)
# and 8443 (agents).
WEB_PORT=8080
AGENT_PORT=8443
# Address the host ports are bound to. 127.0.0.1 keeps them local.
BIND_ADDRESS=0.0.0.0

# auto: HTTPS with a certificate from the internal web CA.
# off: plain HTTP, only behind a reverse proxy that terminates TLS.
WEB_TLS=auto
# Names in the automatic web certificate (comma-separated).
WEB_SERVER_NAMES=localhost
# Names in the agent listener certificate. Agents must connect with one of
# these names; "server" is the name of the service inside compose.
AGENT_SERVER_NAMES=localhost,server

# Console login. ADMIN_PASSWORD_HASH is an argon2id PHC string written by
# init.sh (bomcensus-server hash-password); keep it in single quotes.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# 32 random bytes, base64. Written by init.sh. Losing it means losing the
# CA keys and stored credentials.
BOMCENSUS_MASTER_KEY=

# Password of the bundled PostgreSQL. Written by init.sh.
POSTGRES_PASSWORD=

BOMCENSUS_LOG_LEVEL=info

